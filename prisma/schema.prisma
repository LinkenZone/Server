generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum DocumentStatus {
  pending
  approved
  rejected
}

model User {
  user_id      Int      @id @default(autoincrement()) @map("user_id")
  full_name    String   @db.VarChar(100) @map("full_name")
  email        String   @unique @db.VarChar(255)
  password_hash String  @db.VarChar(255) @map("password_hash")
  role         UserRole @default(user)
  created_at   DateTime @default(now()) @db.Timestamptz @map("created_at")
  password_changed_at DateTime? @db.Timestamptz
  password_reset_token   String?   @db.VarChar(255)
  password_reset_expires DateTime?
  is_banned    Boolean  @default(false) @map("is_banned")
  
  // Relations
  uploaded_documents Document[] @relation("DocumentUploader")
  ratings            Rating[]
  comments           Comment[]
  
  @@map("users")
}

enum SubjectType {
  Natural
  Social
}

model Subject {
  subject_id   Int    @id @default(autoincrement()) @map("subject_id")
  subject_name String @unique @db.VarChar(100) @map("subject_name")
  subject_code String? @unique @db.VarChar(20) @map("subject_code")
  subject_type SubjectType? @map("subject_type")
  
  // Relations
  documents Document[]
  
  @@map("subjects")
}

model Lecturer {
  lecturer_id   Int    @id @default(autoincrement()) @map("lecturer_id")
  lecturer_name String @db.VarChar(100) @map("lecturer_name")
  
  // Relations
  documents Document[]
  
  @@map("lecturers")
}

model Document {
  document_id   Int            @id @default(autoincrement()) @map("document_id")
  title         String         @db.VarChar(255)
  description   String?        @db.Text
  file_url      String         @db.VarChar(255) @map("file_url")
  file_type     String?        @db.VarChar(100) @map("file_type")
  file_size     BigInt?        @map("file_size")
  status        DocumentStatus @default(pending)
  uploader_id   Int?           @map("uploader_id")
  subject_id    Int?           @map("subject_id")
  lecturer_id   Int?           @map("lecturer_id")
  uploaded_at   DateTime       @default(now()) @db.Timestamptz @map("uploaded_at")
  approved_at   DateTime?      @db.Timestamptz @map("approved_at")
  is_deleted    Boolean        @default(false) @map("is_deleted") 
  deleted_at    DateTime?      @db.Timestamptz @map("deleted_at") 
  is_starred    Boolean        @default(false) @map("is_starred")
  last_accessed DateTime?      @db.Timestamptz @map("last_accessed")
  shared_with   Int[]          @default([]) @map("shared_with")

  // Relations
  uploader User?     @relation("DocumentUploader", fields: [uploader_id], references: [user_id], onDelete: SetNull)
  subject  Subject?  @relation(fields: [subject_id], references: [subject_id], onDelete: SetNull)
  lecturer Lecturer? @relation(fields: [lecturer_id], references: [lecturer_id], onDelete: SetNull)
  ratings  Rating[]
  comments Comment[]

  // Indexes
  @@index([uploader_id])
  @@index([subject_id])
  @@index([lecturer_id])
  @@index([is_deleted])
  @@index([is_starred])
  @@index([last_accessed])
  @@map("documents")
}


model Rating {
  rating_id   Int      @id @default(autoincrement()) @map("rating_id")
  score       Int      @db.SmallInt
  user_id     Int      @map("user_id")
  document_id Int      @map("document_id")
  rated_at    DateTime @default(now()) @db.Timestamptz @map("rated_at")
  
  // Relations
  user     User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  document Document @relation(fields: [document_id], references: [document_id], onDelete: Cascade)
  
  // Constraints
  @@unique([user_id, document_id])
  @@index([document_id])
  @@map("ratings")
}

model Comment {
  comment_id  Int      @id @default(autoincrement()) @map("comment_id")
  content     String   @db.Text
  user_id     Int      @map("user_id")
  document_id Int      @map("document_id")
  created_at  DateTime @default(now()) @db.Timestamptz @map("created_at")
  
  // Relations
  user     User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  document Document @relation(fields: [document_id], references: [document_id], onDelete: Cascade)
  
  // Indexes
  @@index([document_id])
  @@map("comments")
}

model Report {
  report_id          Int      @id @default(autoincrement()) @map("report_id")
  today_upload       Int      @default(0) @map("today_upload")
  today_new_user     Int      @default(0) @map("today_new_user")
  weekly_access      Int      @default(0) @map("weekly_access")
  total_download     Int      @default(0) @map("total_download")
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz @map("updated_at")
  created_at         DateTime @default(now()) @db.Timestamptz @map("created_at")
  
  @@map("reports")
}
